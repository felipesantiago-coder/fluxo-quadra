    "html": "<html lang=\"pt-BR\"><head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>QuadraImob | Plataforma Imobiliária</title>\n\n    <meta name=\"apple-mobile-web-app-title\" content=\"QuadraImob\">\n    <meta name=\"application-name\" content=\"QuadraImob\">\n    <meta name=\"msapplication-TileColor\" content=\"#272727\">\n    <meta name=\"msapplication-config\" content=\"/Content/favicon/browserconfig.xml\">\n    <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/Content/favicon/apple-touch-icon.png\">\n    <link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/Content/favicon/favicon-32x32.png\">\n    <link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"/Content/favicon/favicon-16x16.png\">\n    <link rel=\"manifest\" href=\"/manifest.json\">\n    <link rel=\"mask-icon\" href=\"/Content/favicon/safari-pinned-tab.svg\" color=\"#272727\">\n    <link rel=\"shortcut icon\" href=\"/Content/favicon/favicon.ico\">\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\">\n\n    <link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css\" rel=\"stylesheet\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&amp;display=swap\" rel=\"stylesheet\">\n    <link rel=\"stylesheet\" href=\"https://cdn.inforcedata.com.br/gapo/assets/css/main.css\">\n    <link rel=\"stylesheet\" href=\"https://cdn.inforcedata.com.br/gapo/assets/css/dark-mode.css\">\n    <!-- Font Awesome Pro -->\n    <link href=\"//cdn-sites.inforcedata.com.br/assets/libs/fontawesome-pro/5.15.4/css/all.min.css\" rel=\"stylesheet\">\n    <style>\n        .auth-wrapper {\n            min-height: 100vh;\n        }\n\n        .auth-side-img {\n            background: url('https://images.unsplash.com/photo-1451187580459-43490279c0fa?q=80&w=2672&auto=format&fit=crop') no-repeat center center;\n            background-size: cover;\n            position: relative;\n        }\n\n        .auth-overlay {\n            background: linear-gradient(135deg, rgba(17, 24, 39, 0.9) 0%, rgba(0, 0, 0, 0.95) 100%);\n            position: absolute;\n            inset: 0;\n        }\n    </style>\n</head>\n<body class=\"bg-white\" style=\"font-size: 0.9rem;\">\n\n    <div class=\"container-fluid p-0 auth-wrapper overflow-hidden\">\n        <div class=\"row g-0 h-100 min-vh-100\">\n            <!-- Esquerda: Container Interativo -->\n            <div class=\"col-lg-5 d-flex flex-column justify-content-center bg-white p-5 shadow position-relative z-1\">\n                <div class=\"w-100 mx-auto\" style=\"max-width: 420px;\">\n\n                    <div class=\"mb-5 text-center text-lg-start\">\n                        <img src=\"https://cdn-sites.inforcedata.com.br/assets/img/logo-inforce-assinatura.svg\" alt=\"Inforce\" height=\"46\" class=\"mb-4\">\n                        <h3 class=\"fw-bold mb-2 text-dark\">Plataforma Imobiliária</h3>\n                        <p class=\"text-muted\">Acesse para gerenciar seus negócios.</p>\n                    </div>\n\n                    <!-- Error Alert Container -->\n                    <div id=\"alert-container\"></div>\n\n                    <!-- VIEW: LOGIN -->\n                    <div id=\"view-login\" class=\"auth-view animation-fade-in\">\n                        <form action=\"/login\" method=\"POST\" id=\"loginForm\">\n                            <input type=\"hidden\" id=\"redirectUrl\">\n                            <div class=\"form-floating mb-3\">\n                                <input type=\"text\" class=\"form-control\" id=\"inputUser\" name=\"username\" autocomplete=\"username\" placeholder=\"name@example.com\" required=\"\">\n                                <label for=\"inputUser\">Usuário ou Email</label>\n                            </div>\n\n                            <div class=\"form-floating mb-4\">\n                                <input type=\"password\" class=\"form-control\" id=\"inputPassword\" name=\"password\" autocomplete=\"password\" placeholder=\"Password\" required=\"\">\n                                <label for=\"inputPassword\">Senha</label>\n                            </div>\n\n                            <div class=\"d-flex justify-content-between align-items-center mb-4\">\n                                <div class=\"form-check\">\n                                    <input class=\"form-check-input\" type=\"checkbox\" id=\"remember\">\n                                    <label class=\"form-check-label text-muted small\" for=\"remember\">Lembrar de mim</label>\n                                </div>\n                                <a href=\"#\" onclick=\"switchView('recovery'); return false;\" class=\"text-primary text-decoration-none small fw-semibold\">Esqueceu a senha?</a>\n                            </div>\n\n                            <button type=\"submit\" id=\"btn-entrar\" class=\"btn btn-primary w-100 py-3 rounded-3 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2 transition-all hover-scale mb-4\">\n                                Entrar\n                                <i class=\"fal fa-arrow-right\"></i>\n                            </button>\n                        </form>\n\n                        <!-- Ambiente Seguro -->\n                        <div class=\"p-3 bg-light rounded text-center border\">\n                            <div class=\"d-flex align-items-center justify-content-center gap-2 mb-1\">\n                                <i class=\"fal fa-shield-check text-success fs-5\"></i>\n                                <span class=\"fw-bold text-dark\">Ambiente Seguro</span>\n                            </div>\n                            <small class=\"text-muted\">Seu IP: 34.34.253.129</small>\n                        </div>\n                    </div>\n\n                    <!-- VIEW: RECOVERY -->\n                    <div id=\"view-recovery\" class=\"auth-view animation-fade-in\" style=\"display: none;\">\n                        <div class=\"mb-4\">\n                            <h5 class=\"fw-bold mb-2\">Esqueceu a sua senha?</h5>\n                            <p class=\"text-muted small\">Digite o seu usuário ou email para receber uma nova senha temporária.</p>\n                        </div>\n\n                        <form onsubmit=\"submitRecovery(event)\">\n                            <div class=\"form-floating mb-4\">\n                                <input type=\"text\" class=\"form-control\" id=\"recoveryInput\" placeholder=\"name@example.com\" required=\"\">\n                                <label for=\"recoveryInput\">Usuário ou Email</label>\n                            </div>\n\n                            <button type=\"submit\" class=\"btn btn-primary w-100 py-3 rounded-3 fw-bold shadow-sm mb-3 hover-scale\">\n                                Recuperar acesso\n                            </button>\n\n                            <button type=\"button\" onclick=\"switchView('login')\" class=\"btn btn-outline-secondary w-100 py-2 rounded-3 fw-semibold border-0 text-muted\">\n                                <i class=\"fal fa-arrow-left me-2\"></i> Voltar para o login\n                            </button>\n                        </form>\n                    </div>\n\n                    <!-- VIEW: SUCCESS -->\n                    <div id=\"view-success\" class=\"auth-view animation-fade-in text-center\" style=\"display: none;\">\n                        <div class=\"mb-4\">\n                            <!-- Undraw Illustration -->\n                            <img src=\"https://cdn.inforcedata.com.br/gapo/assets/img/undraw_mail_sent.svg\" data-src=\"https://cdn.inforcedata.com.br/gapo/assets/img/undraw_mail_sent.svg\" onerror=\"this.src='https://cdn.inforcedata.com.br/gapo/assets/img/astronaut.png'\" class=\"img-fluid mb-4 floating-astro\" style=\"max-height: 180px;\" alt=\"Mail Sent\">\n\n                            <h4 class=\"fw-bold text-success mb-2\">Sucesso!</h4>\n                            <p class=\"text-muted\">Uma nova senha temporária foi enviada para o e-mail cadastrado no sistema.</p>\n                        </div>\n\n                        <div class=\"alert alert-warning border-0 bg-warning bg-opacity-10 small text-start mb-4\">\n                            <i class=\"fal fa-exclamation-triangle me-1\"></i>\n                            <strong>Atenção:</strong> o remetente é <u>naoresponda@inforcemail.com.br</u>. Verifique sua caixa de spam.\n                        </div>\n\n                        <button type=\"button\" onclick=\"switchView('login')\" class=\"btn btn-primary w-100 py-3 rounded-3 fw-bold shadow-sm hover-scale\">\n                            Voltar para o login\n                        </button>\n                    </div>\n\n                    <div class=\"mt-4 pt-3 border-top text-center\">\n                        <span class=\"badge bg-light text-muted border fw-normal py-2 px-3 rounded-pill\" style=\"font-size: 0.75rem; letter-spacing: 0.5px;\">\n                            Versão: 17.7.1\n                        </span>\n                    </div>\n                </div>\n\n                <div class=\"mt-auto text-center text-muted small pt-4 d-none d-lg-block\">\n                    © 2026 Inforce. Todos os direitos reservados.\n                </div>\n            </div>\n\n            <!-- Direita: Banner HQ -->\n            <div class=\"col-lg-7 d-none d-lg-block position-relative overflow-hidden\" style=\"background: url('https://cdn.inforcedata.com.br/gapo/assets/img/login-bg-v3-hq.png') no-repeat center center; background-size: cover;\">\n\n                <!-- Dark Overlay Gradient -->\n                <div class=\"position-absolute top-0 start-0 w-100 h-100\" style=\"background: linear-gradient(to bottom, rgba(0,0,0,0) 0%, rgba(0,0,0,0.3) 60%, rgba(0,0,0,0.9) 100%);\">\n                </div>\n\n                <!-- Content Wrapper -->\n                <div class=\"d-flex flex-column justify-content-between h-100 w-100 p-5 position-relative z-2\">\n\n                    <!-- TOP: Animated IA Element -->\n                    <div class=\"d-flex justify-content-end pt-4 pe-4\">\n                        <div class=\"ia-pulse-container position-relative cursor-pointer\" data-bs-toggle=\"popover\" data-bs-trigger=\"hover\" data-bs-placement=\"left\" data-bs-html=\"true\" title=\"&lt;i class='fal fa-sparkles text-warning me-2'&gt;&lt;/i&gt;Inforce IA\" data-bs-content=\"Nossa &lt;strong&gt;Inteligência Artificial&lt;/strong&gt; está chegando e vai &lt;strong&gt;revolucionar&lt;/strong&gt; a sua imobiliária.\">\n                            <div class=\"pulse-ring\"></div>\n                            <div class=\"pulse-ring delay-1\"></div>\n                            <div class=\"ia-icon-circle d-flex align-items-center justify-content-center shadow-lg\">\n                                <i class=\"fal fa-robot fs-3 text-white\"></i>\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- BOTTOM: Carousel & Action -->\n                    <div class=\"d-flex flex-column align-items-center w-100 mb-5 pb-4\">\n\n                        <div id=\"authCarousel\" class=\"carousel slide w-100\" data-bs-ride=\"carousel\" style=\"margin-bottom: 2rem;\">\n                            <div class=\"carousel-inner text-white text-center\">\n                                <!-- Slide 1: IA -->\n                                <div class=\"carousel-item active\">\n                                    <div class=\"mb-3\"><span class=\"badge bg-white bg-opacity-25 border border-white border-opacity-25 px-3 py-1 rounded-pill fw-light tracking-wide\">EM BREVE</span></div>\n                                    <!-- Text Reduced: display-5 -> fs-2 / fs-4 -> fs-5 -->\n                                    <h2 class=\"fs-1 fw-bold mb-3 text-gradient-ia\">Inteligência Artificial</h2>\n                                    <p class=\"lead opacity-75 fs-5 lh-lg mx-auto\" style=\"max-width: 600px;\">\n                                        A Inforce está preparando novos recursos com IA.\n                                    </p>\n                                </div>\n                                <!-- Slide 2: Interface -->\n                                <div class=\"carousel-item\">\n                                    <div class=\"mb-3\"><span class=\"badge bg-white bg-opacity-25 border border-white border-opacity-25 px-3 py-1 rounded-pill fw-light tracking-wide\">EM BREVE</span></div>\n                                    <h2 class=\"fs-1 fw-bold mb-3 text-gradient-ia\">Interface 2026</h2>\n                                    <p class=\"lead opacity-75 fs-5 lh-lg mx-auto\" style=\"max-width: 600px;\">\n                                        Um app super moderno está chegando...\n                                    </p>\n                                </div>\n                                <!-- Slide 3: Funcionalidades -->\n                                <div class=\"carousel-item\">\n                                    <div class=\"mb-3\"><span class=\"badge bg-success bg-opacity-75 border border-success border-opacity-50 px-3 py-1 rounded-pill fw-light tracking-wide\">NOVO</span></div>\n                                    <h2 class=\"fs-1 fw-bold mb-3 text-gradient-ia\">Novas Funcionalidades</h2>\n                                    <p class=\"lead opacity-75 fs-5 lh-lg mx-auto\" style=\"max-width: 600px;\">\n                                        APIs avançadas, Temporizador, Kanban e novas integrações.\n                                    </p>\n                                </div>\n                            </div>\n\n                            <!-- Indicators -->\n                            <div class=\"carousel-indicators justify-content-center position-relative mt-4\">\n                                <button type=\"button\" data-bs-target=\"#authCarousel\" data-bs-slide-to=\"0\" class=\"active modern-bullet\"></button>\n                                <button type=\"button\" data-bs-target=\"#authCarousel\" data-bs-slide-to=\"1\" class=\"modern-bullet\"></button>\n                                <button type=\"button\" data-bs-target=\"#authCarousel\" data-bs-slide-to=\"2\" class=\"modern-bullet\"></button>\n                            </div>\n                        </div>\n\n                        <!-- Fixed Action Button (Updated Hover) -->\n                        <!--\n                        <a href=\"https://pesquisa.inforce.com.br\" target=\"_blank\" class=\"btn btn-outline-light rounded-pill px-4 py-2 mt-2 glass-effect hover-glass\">\n                            Escolha novos recursos <i class=\"fal fa-external-link ms-2 small\"></i>\n                        </a>\n                        -->\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n\n\n    <style>\n        /* View Switching Animation */\n        @keyframes fadeIn {\n            from {\n                opacity: 0;\n                transform: translateY(10px);\n            }\n\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        .animation-fade-in {\n            animation: fadeIn 0.4s ease-out forwards;\n        }\n\n        /* Modern Bullets */\n        .modern-bullet {\n            width: 10px !important;\n            height: 10px !important;\n            border-radius: 50%;\n            border: 2px solid rgba(255,255,255,0.5) !important;\n            background-color: transparent !important;\n            opacity: 0.7;\n            margin: 0 6px !important;\n            transition: all 0.3s ease;\n        }\n\n            .modern-bullet.active {\n                background-color: #fff !important;\n                border-color: #fff !important;\n                width: 30px !important;\n                border-radius: 10px;\n                opacity: 1;\n            }\n\n        .hover-scale:hover {\n            transform: translateY(-2px);\n        }\n\n        .transition-all {\n            transition: all 0.3s ease;\n        }\n\n        /* IA Pulse */\n        .ia-icon-circle {\n            width: 60px;\n            height: 60px;\n            border-radius: 50%;\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n            z-index: 2;\n            position: relative;\n        }\n\n        .pulse-ring {\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            bottom: 0;\n            border-radius: 50%;\n            border: 2px solid rgba(118, 75, 162, 0.6);\n            animation: pulse-animation 2s infinite linear;\n        }\n\n        .delay-1 {\n            animation-delay: 1s;\n            border-color: rgba(102, 126, 234, 0.6);\n        }\n\n        @keyframes pulse-animation {\n            0% {\n                transform: scale(1);\n                opacity: 0.8;\n            }\n\n            100% {\n                transform: scale(2);\n                opacity: 0;\n            }\n        }\n\n        .ia-pulse-container:hover .ia-icon-circle {\n            transform: scale(1.1);\n            transition: transform 0.3s;\n        }\n\n        /* Text Gradient */\n        .text-gradient-ia {\n            background: linear-gradient(to right, #fff, #e0eafc);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n        }\n\n        .tracking-wide {\n            letter-spacing: 2px;\n        }\n\n        /* Glass Button & Hover */\n        .glass-effect {\n            background: rgba(255, 255, 255, 0.1);\n            backdrop-filter: blur(10px);\n            border: 1px solid rgba(255, 255, 255, 0.2);\n            transition: all 0.3s;\n        }\n\n        .hover-glass:hover {\n            background: #fff !important;\n            color: #764ba2 !important; /* Strong contrast liquid purple */\n            transform: translateY(-3px) scale(1.05);\n            box-shadow: 0 10px 20px rgba(0,0,0,0.2);\n        }\n\n        /* Floating Astro Animation */\n        .floating-astro {\n            animation: float 6s ease-in-out infinite;\n        }\n\n        @keyframes float {\n            0% {\n                transform: translateY(0px);\n            }\n\n            50% {\n                transform: translateY(-15px);\n            }\n\n            100% {\n                transform: translateY(0px);\n            }\n        }\n\n        /* Popover */\n        .popover {\n            border: 0;\n            box-shadow: 0 10px 30px rgba(0,0,0,0.2);\n            font-family: 'Inter', sans-serif;\n        }\n\n        .popover-header {\n            background: #f8f9fa;\n            border-bottom: 0;\n            font-weight: bold;\n        }\n    </style>\n    <script>\n      window._gapoConfigTenantId = 'quadraimob';\n      window._gapoHostImage      = 'https://quadraimob.inforcedata.com.br/api/image';\n    </script>\n    <script src=\"/wwwroot/js/deviceinfo.bundle.js?v=202607011538038518\"></script>\n\n    <script src=\"/wwwroot/js/login.bundle.js?v=202607011538038523\"></script>\n\n    <script src=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js\"></script>\n    <script>\n        function registerServiceWorker() {\n            if (!(\"serviceWorker\" in navigator)) return;\n\n            const version = \"v=20260622\";\n\n            window.addEventListener(\"load\", async () => {\n                try {\n                    const registration = await navigator.serviceWorker.register(\n                        `/service-worker.js?${version}`,\n                        { scope: \"/\" }\n                    );\n\n                    await registration.update();\n                } catch (err) {\n                    console.error(\"Service Worker registration failed:\", err);\n                }\n            });\n        }\n\n        registerServiceWorker();\n</script>\n\n<script type=\"module\" src=\"https://static.cloudflareinsights.com/beacon.min.js/v4513226cdae34746b4dedf0b4dfa099e1781791509496\" integrity=\"sha512-ZE9pZaUXND66v380QUtch/5sE9tPFh2zg45pR2PB0CVkCtOREv2AJKkSidISWkysEuQ0EH8faUU5du78bx87UQ==\" data-cf-beacon=\"{&quot;version&quot;:&quot;2024.11.0&quot;,&quot;token&quot;:&quot;688b89d6f7c44a78894fa520b6708240&quot;}\" crossorigin=\"anonymous\"></script>\n<script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML=\"window.__CF$cv$params={r:'a2d27ef99ef1aa54',t:'MTc4NzA3MjY0OQ=='};var a=document.createElement('script');a.src='/cdn-cgi/challenge-platform/scripts/jsd/main.js';document.getElementsByTagName('head')[0].appendChild(a);\";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script><iframe height=\"1\" width=\"1\" style=\"position: absolute; top: 0px; left: 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; visibility: hidden;\"></iframe>\n\n</body></html>",
